NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
TMDB_API_KEY=
MOTN_API_KEY=
CRON_SECRET=

# App environment. Leave unset for production/local. Set to "staging" ONLY in
# the Vercel "Preview -> staging" scope — drives the staging banner, permanent
# noindex, and env-namespaced Redis keys.
NEXT_PUBLIC_ENV=

# Upstash Redis (query caching)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Sentry (error monitoring)
SENTRY_DSN=
